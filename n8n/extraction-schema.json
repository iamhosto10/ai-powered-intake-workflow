{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_id",
    "potential_client_name",
    "contact_name",
    "relationship_to_client",
    "contact_information",
    "facility_or_provider",
    "date_of_incident",
    "injury_type",
    "referral_source",
    "urgency_flag"
  ],
  "properties": {
    "intake_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "Copy the INTAKE ID from the first line of the message exactly. It is a routing key and is never NOT FOUND."
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "potential_client_name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "The injured person's name, or NOT FOUND"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Verbatim quote from the intake, or null"
        }
      }
    },
    "contact_name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationship_to_client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "contact_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone",
        "email"
      ],
      "properties": {
        "phone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "facility_or_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "date_of_incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence",
        "normalized_iso"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "The time expression exactly as stated, or NOT FOUND"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_iso": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD only if a complete absolute date with year is stated; otherwise NOT FOUND (null is also accepted and treated as NOT FOUND)"
        }
      }
    },
    "injury_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "referral_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "urgency_flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "NOT FOUND"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "One sentence explaining the rating"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
